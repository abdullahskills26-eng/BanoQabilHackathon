# SkillBridge backend configuration
# Copy to .env and fill in. .env is gitignored; this example is not.

# ---------------------------------------------------------------- Firebase
# Absolute path to the Firebase service-account JSON.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. This file IS a secret: keep it out of the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json

# Alternative name the app also reads, if you prefer it.
# FIREBASE_CREDENTIALS=C:\path\to\serviceAccountKey.json

# Without either variable the SDK falls back to Application Default
# Credentials, which you can set up with:
#   gcloud auth application-default login

# ----------------------------------------------------------------- Server
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------- CORS
# Comma-separated origins allowed to call this API.
# "*" is fine for local development; narrow it before deploying.
#
# Note: a wildcard and credentialed requests are mutually exclusive in every
# browser, so the app enables allow_credentials only when the origins are
# listed explicitly. This API authenticates with a Bearer token, not cookies,
# so "*" stays workable for local development either way.
# Example for a deployed frontend:
#   CORS_ORIGINS=https://skillbridge-32f45.web.app,http://localhost:8080
CORS_ORIGINS=*

# ------------------------------------------------------------------ Rules
# Attendance percentage below which a student is flagged as at-risk.
ATTENDANCE_RISK_THRESHOLD=75

# ------------------------------------------------------------------- Demo
# Enables the demo/seed endpoints:
#   POST /api/v1/seed-demo-data           (also needs a coordinator token)
#   GET  /api/v1/seed-demo-data/preview
#   POST /api/v1/auth/demo-accounts
#
# OFF unless set. These write fixed records into the live Firestore project
# and provision the demo accounts, so leaving this unset means a deployment
# cannot have its data seeded over, and /auth/demo-accounts cannot be used to
# reset the demo coordinator's password and sign in as staff.
#
# Turn on only for a demo environment:
# DEMO_MODE=true
