<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  Android 9 (API 28) and later block cleartext HTTP by default, so a debug
  build talking to the FastAPI backend over http://10.0.2.2:8000 fails with
  "CLEARTEXT communication not permitted" even when the URL is correct.

  This file lives in src/debug/, so it is merged into debug builds only.
  Release builds keep the platform default and continue to require HTTPS.

  10.0.2.2  - the host machine, as seen from the Android emulator
  10.0.3.2  - the same, for Genymotion
  localhost - the device itself, for adb reverse tcp:8000 tcp:8000
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
